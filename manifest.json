{
  "manifest_version": 3,
  "name": "Bilibili Video Saver",
  "version": "1.3.0",
  "description": "Download the currently selected Bilibili video using the quality available to your account.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.bilivideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bilibili video download",
    "default_popup": "popup.html"
  }
}
